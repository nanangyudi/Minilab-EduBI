# .env.example
# Salin file ini menjadi .env dan sesuaikan nilainya
# JANGAN commit file .env ke git

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=minilab
PG_USER=minilab
PG_PASSWORD=minilab123

# ─────────────────────────────────────────────
# DuckDB
# ─────────────────────────────────────────────
DUCKDB_PATH=data/warehouse/lab_bi.duckdb
RAW_DIR=data/raw

# ─────────────────────────────────────────────
# Pipeline Options
# ─────────────────────────────────────────────
# Set ke "true" untuk juga membaca dari PostgreSQL odoo_sim
# Set ke "false" untuk hanya pakai sample CSV (default PoC)
USE_POSTGRES_SOURCE=false

# ─────────────────────────────────────────────
# Google Places API (opsional)
# Digunakan oleh etl/extract_google_reviews.py
# Biarkan kosong untuk pakai sample_reviews.csv
# ─────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
